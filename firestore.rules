rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // A recently authenticated administrator owns a browser reset. Normal writes
    // stay paused until that administrator verifies and releases the marker.
    function databaseWritable() {
      return !exists(/databases/$(database)/documents/_maintenance/databaseReset);
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (
          request.auth.token.email != null &&
          exists(/databases/$(database)/documents/user_roles/$(request.auth.token.email)) &&
          get(/databases/$(database)/documents/user_roles/$(request.auth.token.email)).data.role == 'admin'
        ) ||
        request.auth.token.email == 'admin@academy.edu' ||
        request.auth.token.email == 'admin@gmail.com' ||
        request.auth.token.email == 'admin@outlook.com' ||
        request.auth.token.email == 'alitshrestha74@gmail.com'
      );
    }

    function isResetOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/_maintenance/databaseReset)
        && get(/databases/$(database)/documents/_maintenance/databaseReset).data.mode == 'browser'
        && get(/databases/$(database)/documents/_maintenance/databaseReset).data.requestedBy == request.auth.uid;
    }

    function recentAuthentication() {
      return isSignedIn() && request.auth.token.auth_time is int
        && request.time.toMillis() - request.auth.token.auth_time * 1000 < 300000;
    }

    function validResetRequest() {
      return request.resource.data.keys().hasOnly(['mode', 'requestedBy', 'runId', 'status', 'updatedAt'])
        && request.resource.data.mode == 'browser'
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.runId is string
        && request.resource.data.runId.size() > 0
        && request.resource.data.runId.size() <= 100
        && request.resource.data.status in ['running', 'failed']
        && request.resource.data.updatedAt == request.time;
    }

    match /_maintenance/databaseReset {
      allow get: if isAdmin() || isResetOwner();
      allow create: if isAdmin() && recentAuthentication() && validResetRequest();
      allow update: if validResetRequest() && (
        (isResetOwner() && resource.data.runId == request.resource.data.runId)
        || (recentAuthentication() && (isAdmin() || isResetOwner())
          && (resource.data.status == 'failed' || resource.data.updatedAt < request.time - duration.value(5, 'm')))
      );
      allow delete: if isResetOwner();
    }

    function hasModuleAccess(moduleName) {
      return isAdmin() || (
        isSignedIn() &&
        (
          request.auth.token.permissions[moduleName] == true ||
          (
            request.auth.token.email != null &&
            exists(/databases/$(database)/documents/user_roles/$(request.auth.token.email)) &&
            get(/databases/$(database)/documents/user_roles/$(request.auth.token.email)).data.permissions[moduleName] == true
          )
        )
      );
    }

    match /user_roles/{email} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email == email);
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /students/{document=**} {
      allow read: if hasModuleAccess('students');
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /activities/{activityId} {
      allow read: if hasModuleAccess('activities');
      allow create, update: if databaseWritable() && isAdmin()
        && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9A-F]{6}$')
        && getAfter(/databases/$(database)/documents/activity_color_locks/$(request.resource.data.color.replace('#', ''))).data.activityId == activityId
        && getAfter(/databases/$(database)/documents/activity_colors/$(activityId)).data.color == request.resource.data.color
        && getAfter(/databases/$(database)/documents/activity_colors/$(activityId)).data.activityName == request.resource.data.activityName
        && getAfter(/databases/$(database)/documents/activity_colors/$(activityId)).data.activityCode == request.resource.data.activityCode;
      allow delete: if databaseWritable() && isAdmin();
    }

    // Calendar readers only need this small public activity palette, not activity pricing.
    match /activity_colors/{activityId} {
      allow read: if hasModuleAccess('activities') || hasModuleAccess('attendance')
        || hasModuleAccess('enrollments') || hasModuleAccess('students');
      allow create, update: if databaseWritable() && isAdmin()
        && request.resource.data.keys().hasOnly(['color', 'activityName', 'activityCode'])
        && request.resource.data.color == getAfter(/databases/$(database)/documents/activities/$(activityId)).data.color
        && request.resource.data.activityName == getAfter(/databases/$(database)/documents/activities/$(activityId)).data.activityName
        && request.resource.data.activityCode == getAfter(/databases/$(database)/documents/activities/$(activityId)).data.activityCode;
    }

    match /activity_color_locks/{hex} {
      allow read: if isAdmin();
      allow create: if databaseWritable() && isAdmin()
        && request.resource.data.keys().hasOnly(['activityId'])
        && getAfter(/databases/$(database)/documents/activities/$(request.resource.data.activityId)).data.color == '#' + hex;
      allow update: if databaseWritable() && isAdmin()
        && request.resource.data == resource.data;
      allow delete: if databaseWritable() && isAdmin()
        && (!existsAfter(/databases/$(database)/documents/activities/$(resource.data.activityId))
          || getAfter(/databases/$(database)/documents/activities/$(resource.data.activityId)).data.color != '#' + hex);
    }

    match /enrollments/{document=**} {
      allow read: if hasModuleAccess('enrollments') || hasModuleAccess('students') || hasModuleAccess('attendance');
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /attendances/{document=**} {
      allow read: if hasModuleAccess('attendance');
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /daily_attendances/{document=**} {
      allow read: if hasModuleAccess('attendance');
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /calendar_entries/{entryId} {
      allow read: if hasModuleAccess('attendance');
      allow create, update: if databaseWritable() && isAdmin()
        && request.resource.data.keys().hasOnly(['dateBS', 'dateAD', 'type', 'title', 'activityId', 'activityName', 'activityCode', 'time', 'notes', 'createdAt'])
        && request.resource.data.dateBS is string
        && request.resource.data.dateBS.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.dateAD is string
        && request.resource.data.dateAD.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.type in ['class', 'event', 'holiday']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.activityId is string
        && (!('activityName' in request.resource.data) || request.resource.data.activityName is string)
        && (!('activityCode' in request.resource.data) || request.resource.data.activityCode is string)
        && (request.resource.data.type != 'class' || request.resource.data.activityId.size() > 0)
        && request.resource.data.time is string
        && (request.resource.data.time == '' || request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000;
      allow delete: if databaseWritable() && isAdmin();
    }

    match /staff/{document=**} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email != null
        && resource.data.email == request.auth.token.email);
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /staffAttendance/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /departments/{document=**} {
      allow read: if hasModuleAccess('staff');
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /roles/{document=**} {
      allow read: if hasModuleAccess('staff');
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /salaryConfigs/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /financeIncome/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /financeExpenses/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /invoices/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /invoiceLocks/{document=**} {
      allow read: if isAdmin();
      allow write: if databaseWritable() && isAdmin();
    }

    match /financePayments/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /accounts/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /bankTransactions/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /financialPeriods/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /journalEntries/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /accountingPostings/{document=**} {
      allow read: if isAdmin();
      allow write: if databaseWritable() && isAdmin();
    }

    match /payrollRuns/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /payrollReservations/{document=**} {
      allow read: if isAdmin();
      allow write: if databaseWritable() && isAdmin();
    }

    match /financeCategoryRules/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if databaseWritable() && isAdmin();
    }

    match /counters/{document=**} {
      allow read: if isAdmin();
      allow write: if databaseWritable() && isAdmin();
    }

    match /auditLogs/{document=**} {
      allow read: if isAdmin();
      allow write: if databaseWritable() && isAdmin();
    }

    match /mail/{document=**} {
      allow read: if isAdmin();
      allow write: if databaseWritable() && isAdmin();
    }

    match /{document=**} {
      // Collection-group queries include orphaned nested records. Only the reset
      // owner gets this temporary read/delete access; never create/update access.
      allow read, delete: if isResetOwner();
    }
  }
}
