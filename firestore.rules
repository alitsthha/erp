rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (
          request.auth.token.email != null &&
          exists(/databases/$(database)/documents/user_roles/$(request.auth.token.email)) &&
          get(/databases/$(database)/documents/user_roles/$(request.auth.token.email)).data.role == 'admin'
        ) ||
        request.auth.token.email == 'admin@academy.edu' ||
        request.auth.token.email == 'admin@gmail.com' ||
        request.auth.token.email == 'admin@outlook.com' ||
        request.auth.token.email == 'alitshrestha74@gmail.com'
      );
    }

    match /user_roles/{email} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email == email);
      allow create, update, delete: if isAdmin();
    }

    match /students/{document=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /activities/{document=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /enrollments/{document=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /attendances/{document=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /daily_attendances/{document=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /staff/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /staffAttendance/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /departments/{document=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /roles/{document=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /salaryConfigs/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /financeIncome/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /financeExpenses/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /invoices/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /invoiceLocks/{document=**} {
      allow read, write: if isAdmin();
    }

    match /financePayments/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /accounts/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /bankTransactions/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /financialPeriods/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /journalEntries/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /accountingPostings/{document=**} {
      allow read, write: if isAdmin();
    }

    match /payrollRuns/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /payrollReservations/{document=**} {
      allow read, write: if isAdmin();
    }

    match /financeCategoryRules/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /counters/{document=**} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{document=**} {
      allow read, write: if isAdmin();
    }

    match /mail/{document=**} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
